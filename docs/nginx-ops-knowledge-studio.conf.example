# Replace the server name and certificate paths before enabling this file.
# The Python service must remain bound to 127.0.0.1:8765.
server {
    listen 443 ssl http2;
    server_name opsstudio.internal;

    ssl_certificate     /etc/ssl/certs/opsstudio.internal.crt;
    ssl_certificate_key /etc/ssl/private/opsstudio.internal.key;

    client_max_body_size 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
    }
}
