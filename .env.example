# DeepSeek 官方 OpenAI 兼容接口。复制为 .env 后填写 API Key。
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 内部 Demo 默认允许 HTTP + 非 localhost 模型地址；生产环境改为 false 并使用 HTTPS。
DEEPSEEK_ALLOW_INSECURE_HTTP=true

# enabled / disabled / 留空使用供应商默认值。知识抽取会固定使用 disabled 以保证 JSON 稳定。
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_INITIAL_SECONDS=0.5
DEEPSEEK_RETRY_MAX_SECONDS=4
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.1
# 模型响应正文上限，防止不受控 read() 占用内存。
MODEL_MAX_RESPONSE_BYTES=2097152

# 本地知识平台
KNOWLEDGE_DB_PATH=data/knowledge.db
KNOWLEDGE_SOURCE_DIR=knowledge_sources
KNOWLEDGE_CHUNK_SIZE=6000
KNOWLEDGE_CHUNK_OVERLAP=500
KNOWLEDGE_TOP_K=6
# 低于任一门槛的候选不会进入可信回答；无强相关知识时直接拒答。
KNOWLEDGE_MIN_SCORE=10
KNOWLEDGE_MIN_COVERAGE=0.15
AGENT_MAX_STEPS=4

# 可选：MindMemOS 长期记忆后端。默认关闭，不影响原有本地检索。
# 启用内容外发必须再显式设置 MINDMEMOS_ALLOW_CONTENT_EXPORT=true；
# 仅外发下列白名单字段，不外发 source_ref、evidence_locator 或原始证据正文。
MINDMEMOS_ENABLED=false
MINDMEMOS_BASE_URL=http://127.0.0.1:8000
MINDMEMOS_API_KEY=MINDMEMOS_API_KEY_HERE
MINDMEMOS_USER_ID=ops-knowledge-studio
MINDMEMOS_APP_ID=ops-knowledge-studio
MINDMEMOS_TIMEOUT_SECONDS=60
MINDMEMOS_TOP_K=10
MINDMEMOS_MAX_SYNC_CARDS=20
# 强制 MindMemOS rerank 阈值 + 本地对象/动作/词项二次交叉验证。
MINDMEMOS_MIN_RELEVANCE_SCORE=0.65
MINDMEMOS_MIN_LOCAL_ANCHORS=2
MINDMEMOS_ALLOW_CONTENT_EXPORT=false
# 仅在本地严格检索无结果时生效；默认最多接纳语义排名第一的本地 APPROVED 卡片。
MINDMEMOS_MAX_SEMANTIC_CARDS=1

# 诊断轨迹默认不保存明文问题；按天数与文件数双重轮转。
# 生产环境建议配置独立高熵 TRACE_HMAC_KEY，用于 HMAC 哈希链完整性校验。
TRACE_RETENTION_DAYS=7
TRACE_MAX_FILES=50
TRACE_HMAC_KEY=
# Harness Runtime：任务状态、检查点和事件存放在独立 SQLite；默认两个后台 Worker。
HARNESS_RUNTIME_DB_PATH=data/runtime.db
HARNESS_WORKERS=2
HARNESS_MAX_QUEUED_RUNS=100
HARNESS_SYNC_WAIT_SECONDS=900

# 内部 Demo 默认关闭启动令牌、Web/API Access Token、Host/Origin 边界检查，
# 但鉴权实现仍保留。生产化时设置 DEMO_MODE=false，并将三个 REQUIRED/ENABLED
# 开关改为 true；再运行 python run.py generate-access-token 生成令牌摘要。
DEMO_MODE=true
STARTUP_TOKEN_REQUIRED=false
ACCESS_TOKEN_REQUIRED=false
PLATFORM_AUTH_MODE=disabled
PLATFORM_ACCESS_TOKEN_HASH=
PLATFORM_REQUEST_BOUNDARY_CHECKS_ENABLED=false
# 当前前端仍含 inline handler；生产改造为 addEventListener 后将此项设为 false。
PLATFORM_CSP_ALLOW_INLINE=true
PLATFORM_SHARED_ACTOR=shared-operator
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8765
# Host 只写主机名/IP，不含端口；Origin 必须包含协议和实际浏览器端口。
PLATFORM_ALLOWED_HOSTS=127.0.0.1,localhost,::1
PLATFORM_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
PLATFORM_REQUESTS_PER_MINUTE=120
PLATFORM_WRITES_PER_MINUTE=30
PLATFORM_EXPENSIVE_PER_MINUTE=5
PLATFORM_MAX_JSON_BYTES=262144

# 知识导入费用与并发边界。
KNOWLEDGE_MAX_TEXT_CHARS=120000
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=20
# 仅结构指纹匹配成功的变更单 JSON 可以使用以下较大边界。
KNOWLEDGE_MAX_CHANGE_ORDER_JSON_CHARS=500000
KNOWLEDGE_MAX_CHANGE_ORDER_CHUNKS=40
KNOWLEDGE_CHANGE_ORDER_CHUNK_SIZE=12000
CHANGE_ORDER_CARD_TIMEZONE=Asia/Shanghai
CHANGE_ORDER_PROCEDURE_SPLIT_CHARS=6000
CHANGE_ORDER_SEMANTIC_SECTION_THRESHOLD=5
CHANGE_ORDER_CHILD_MIN_CONTENT_CHARS=160
CHANGE_ORDER_SEMANTIC_REUSE_THRESHOLD=0.92
CHANGE_ORDER_CARD_REPORT_DIR=artifacts/change_order_card_reports
DEMO_REBUILD_ENABLED=true
# 可选的全库重置本轮保持关闭；当前案例重建不依赖此开关。
DEMO_FULL_RESET_ENABLED=false
KNOWLEDGE_MAX_MODEL_CALLS_PER_INGEST=60
KNOWLEDGE_MAX_CARDS_PER_DOCUMENT=30
KNOWLEDGE_MAX_CONCURRENT_INGESTIONS=1

# 恶意文档解析边界。
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_DOCX_ENTRIES=1000
DOCUMENT_MAX_DOCX_UNCOMPRESSED_BYTES=52428800
DOCUMENT_MAX_DOCX_XML_BYTES=10485760
DOCUMENT_MAX_COMPRESSION_RATIO=100
DOCUMENT_MAX_PDF_PAGES=100
DOCUMENT_MAX_OCR_PAGES=20
DOCUMENT_MAX_IMAGE_PIXELS=25000000
DOCUMENT_PARSE_TIMEOUT_SECONDS=120

# 合成变更会话生命周期。过期工作区会从 artifacts/change_demos 安全清理。
CHANGE_MAX_ACTIVE_SESSIONS=3
CHANGE_MAX_RETAINED_SESSIONS=20
CHANGE_ACTIVE_TTL_SECONDS=7200
CHANGE_TERMINAL_TTL_SECONDS=86400

# 真实 ChangeOrder 草案能力默认关闭。仅在内网完成 SchemaProfile 审核后启用。
REAL_CHANGE_GENERATION_ENABLED=false
CHANGE_DRAFT_DB_PATH=data/change_drafts.db
CHANGE_GENERATION_MAX_CASE_BUNDLES=3
# 按完整案例包计入上下文；超过边界时失败，不会静默截断卡片。
CHANGE_GENERATION_MAX_CONTEXT_CARDS=24
